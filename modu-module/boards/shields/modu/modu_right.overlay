 *
 * BLE wireless peripheral. Forwards its trackball to central via input-split.
 */

#include "modu.dtsi"

&default_transform {
    col-offset = <6>;
};

&kscan_direct {
    input-gpios
        = <&gpio0 26 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
        , <&gpio0  4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
        , <&gpio0  5 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
        , <&gpio1  8 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
        ;
};

&trackball_split {
    device = <&trackball>;
};

&trackball {
    invert-x;
};
